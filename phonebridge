#!/usr/bin/env python3
"""phonebridge — backend daemon/CLI for PC<->Android file + clipboard relay.

Every phone interaction here is plain adb + shell; no desktop toolkit
required. Any UI (quickshell, waybar, rofi, a shell script) can build on
top of these subcommands.

Subcommands (all print JSON to stdout; errors go to stderr, exit != 0):
  devices                      list attached devices [{id, name}]
  connect [addr]               adb connect (defaults to remembered target)
  battery                      {level, charging}
  clip --text T | --file F     set the phone clipboard via the relay app
  push <local> [remote-dir]    push a file + trigger the media scanner
  pull <name> [--dir D] [--dest DIR]
  ls [remote-dir]              [{name, isDir}]
  shot [--dest DIR]            screencap -> PNG, prints path
  ring                         wake + max volume + vibrate burst
  wake                         screen wake only
  inbox-sync [--dest DIR]      pull new share-sheet files -> dest
  inbox-watch [--interval N]   inbox-sync loop, one JSON line per arrival
  notifs                       one-shot notification records
  notifs-watch [--interval N]  new notification records as JSON lines

Config: ~/.config/phonebridge/config.ini (written by init.sh).
  [phone]  device, remote_dir, inbox_dir, downloads
  [display] alias_<n> = <model substring> = <label>   (friendly names)
  [notify] app_<n> = <pkg substring> = <label>        (watch allowlist)

Verified against itel A663LC / Android 13. Known ROM quirks (see README):
clipboard reads are blocked, relay-set clips are reaped within seconds
(paste immediately), share-sheet inbox is the robust phone->PC channel.
"""

import configparser
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

APP_PKG = "dev.phonebridge.relay"
CONFIG = os.path.expanduser("~/.config/phonebridge/config.ini")
INBOX_DEFAULT = "/sdcard/PhoneBridge"


def inbox_dir(c):
    return cfg_get(c, "phone", "inbox_dir", INBOX_DEFAULT)
CLIP_MAX = 100000
INBOX_MAX = 250 * 1024 * 1024


def q(s):
    return shlex.quote(str(s))


def load_config():
    c = configparser.ConfigParser()
    c.read(CONFIG)
    return c


def cfg_get(c, section, key, default=""):
    try:
        return c.get(section, key, fallback=default)
    except Exception:
        return default


def aliases(c):
    out = []
    if c.has_section("display"):
        for _, v in c.items("display"):
            if "=" in v:
                sub, _, label = v.partition("=")
                out.append((sub.strip(), label.strip()))
    return out


def notify_apps(c):
    out = []
    if c.has_section("notify"):
        for _, v in c.items("notify"):
            if "=" in v:
                sub, _, label = v.partition("=")
                out.append((sub.strip(), label.strip()))
    return out


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def adb(device, *args):
    cmd = ["adb"]
    if device:
        cmd += ["-s", device]
    cmd += list(args)
    return run(cmd)


def resolve_device(c, explicit=""):
    if explicit:
        return explicit
    dev = cfg_get(c, "phone", "device")
    if dev:
        return dev
    r = run(["adb", "devices"])
    for line in r.stdout.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2 and parts[1] == "device":
            return parts[0]
    return ""


def emit(obj):
    print(json.dumps(obj))


def fail(msg, code=1):
    print(f"phonebridge: {msg}", file=sys.stderr)
    sys.exit(code)


# ── devices ──────────────────────────────────────────────────────────────
def cmd_devices(c, _args):
    r = run(["adb", "devices", "-l"])
    found = []
    als = aliases(c)
    for line in r.stdout.strip().split("\n"):
        m = __import__("re").match(r"^(\S+)\s+device\b", line)
        if not m:
            continue
        mod = __import__("re").search(r"\bmodel:(\S+)", line)
        name = mod.group(1).replace("_", " ") if mod else "Phone"
        for sub, label in als:
            if sub.lower() in name.lower():
                name = label
                break
        found.append({"id": m.group(1), "name": name})
    emit(found)


def cmd_connect(c, args):
    addr = args[0] if args else cfg_get(c, "phone", "target")
    if not addr:
        fail("no address: pass one or set phone.target in " + CONFIG, 2)
    r = run(["adb", "connect", addr])
    out = r.stdout + r.stderr
    if "connected to" in out or "already connected" in out:
        emit({"status": "ok", "target": addr})
    else:
        fail("phone not answering: " + out.strip()[:120])


# ── battery ──────────────────────────────────────────────────────────────
def cmd_battery(c, args):
    dev = resolve_device(c, args[0] if args else "")
    if not dev:
        fail("no device")
    r = adb(dev, "shell", "dumpsys", "battery")
    lv = __import__("re").search(r"level:\s*(\d+)", r.stdout)
    st = __import__("re").search(r"status:\s*(\d+)", r.stdout)
    emit({"level": int(lv.group(1)) if lv else -1,
          "charging": (st.group(1) == "2") if st else False})


# ── clipboard push (PC -> phone) ─────────────────────────────────────────
def cmd_clip(c, args):
    import argparse
    p = argparse.ArgumentParser(prog="phonebridge clip")
    p.add_argument("--text", default=None)
    p.add_argument("--file", default=None)
    ns = p.parse_args(args)
    dev = resolve_device(c)
    if not dev:
        fail("no device")
    clip_file = os.path.expanduser("~/.cache/phonebridge-clipboard.txt")
    if ns.text is not None:
        data = ns.text.encode()
    elif ns.file:
        with open(os.path.expanduser(ns.file), "rb") as f:
            data = f.read()
    else:
        data = sys.stdin.buffer.read()
    if len(data) == 0:
        emit({"status": "empty"})
        return
    if len(data) > CLIP_MAX:
        emit({"status": "toolong", "bytes": len(data)})
        return
    with open(clip_file, "wb") as f:
        f.write(data)
    rdir = f"/sdcard/Android/data/{APP_PKG}/files"
    ok = (
        adb(dev, "push", clip_file, f"{rdir}/in.txt").returncode == 0
        and adb(dev, "shell", "am", "start", "-n",
                f"{APP_PKG}/.PhoneBridgeActivity",
                "--es", "mode", "write",
                "--es", "textfile", f"{rdir}/in.txt").returncode == 0
    )
    if not ok:
        emit({"status": "fail"})
        return
    time.sleep(1.5)
    ack = adb(dev, "shell", "cat", f"{rdir}/ack.txt").stdout
    if "OK" in ack:
        emit({"status": "ok"})
    else:
        emit({"status": "fail"})
        sys.exit(1)
        sys.exit(1)


# ── push / pull / ls / shot / scan ───────────────────────────────────────
def cmd_push(c, args):
    if not args:
        fail("usage: phonebridge push <local-file> [remote-dir]", 2)
    dev = resolve_device(c)
    if not dev:
        fail("no device")
    local = os.path.expanduser(args[0])
    rdir = args[1] if len(args) > 1 else cfg_get(c, "phone", "remote_dir", "/sdcard/Download")
    r = adb(dev, "push", local, rdir)
    if r.returncode != 0:
        fail((r.stderr.strip().split("\n") or ["push failed"])[-1][:120])
    name = os.path.basename(local)
    uri = "file://" + rdir + "/" + name
    adb(dev, "shell", "am", "broadcast",
        "-a", "android.intent.action.MEDIA_SCANNER_SCAN_FILE", "-d", uri)
    emit({"status": "ok", "name": name, "remote": rdir + "/" + name})


def cmd_pull(c, args):
    import argparse
    p = argparse.ArgumentParser(prog="phonebridge pull")
    p.add_argument("name")
    p.add_argument("--dir", default=None)
    p.add_argument("--dest", default=None)
    ns = p.parse_args(args)
    dev = resolve_device(c)
    if not dev:
        fail("no device")
    rdir = ns.dir or cfg_get(c, "phone", "remote_dir", "/sdcard/Download")
    dest = os.path.expanduser(ns.dest or cfg_get(c, "phone", "downloads", "~/PhoneBridge"))
    os.makedirs(dest, exist_ok=True)
    r = adb(dev, "pull", f"{rdir}/{ns.name}", dest + "/")
    # NOTE: adb prints "1 file pulled" for files but "N files pulled" for
    # directories — returncode is the only reliable success signal.
    if r.returncode != 0:
        fail((r.stderr.strip().split("\n") or ["pull failed"])[-1][:120])
    emit({"status": "ok", "name": ns.name, "path": dest + "/" + ns.name})


def cmd_ls(c, args):
    dev = resolve_device(c)
    if not dev:
        fail("no device")
    rdir = args[0] if args else cfg_get(c, "phone", "remote_dir", "/sdcard/Download")
    r = adb(dev, "shell", "ls", "-p", rdir)
    rows = []
    for line in r.stdout.strip().split("\n"):
        n = line.strip()
        if not n:
            continue
        rows.append({"name": n.rstrip("/"), "isDir": n.endswith("/")})
    rows.sort(key=lambda e: (not e["isDir"], e["name"].lower()))
    emit(rows)


def cmd_shot(c, args):
    import argparse
    p = argparse.ArgumentParser(prog="phonebridge shot")
    p.add_argument("--dest", default=None)
    ns = p.parse_args(args)
    dev = resolve_device(c)
    if not dev:
        fail("no device")
    dest = os.path.expanduser(ns.dest or cfg_get(c, "phone", "shots", "~/Pictures/PhoneBridge"))
    os.makedirs(dest, exist_ok=True)
    name = "phonebridge-" + time.strftime("%Y%m%d-%H%M%S") + ".png"
    path = dest + "/" + name
    with open(path, "wb") as f:
        r = subprocess.run(["adb", "-s", dev, "exec-out", "screencap", "-p"],
                           stdout=f, stderr=subprocess.PIPE)
    if r.returncode != 0 or os.path.getsize(path) == 0:
        fail("shot failed — screen on and unlocked?")
    emit({"status": "ok", "name": name, "path": path})


# ── ring / wake ──────────────────────────────────────────────────────────
def cmd_ring(c, args):
    dev = resolve_device(c, args[0] if args else "")
    if not dev:
        fail("no device")
    adb(dev, "shell", "input", "keyevent", "224")  # wake
    adb(dev, "shell", "cmd", "media_session", "volume", "--stream", "3", "--set", "15")
    adb(dev, "shell", "am", "start", "-a", "android.intent.action.VIEW",
        "-d", "content://settings/system/ringtone")
    for _ in range(3):
        adb(dev, "shell", "cmd", "vibrator_manager", "synced",
            "-f", "oneshot", "400", "255")
        time.sleep(0.35)
    emit({"status": "ok"})


def cmd_wake(c, args):
    dev = resolve_device(c, args[0] if args else "")
    if not dev:
        fail("no device")
    adb(dev, "shell", "input", "keyevent", "224")
    emit({"status": "ok"})


# ── inbox: share-sheet files phone -> PC ─────────────────────────────────
def inbox_list(dev, inbox):
    """[(size, name)] for files in the share-sheet inbox dir."""
    r = adb(dev, "shell",
            "for f in " + inbox + "/*; do [ -f \"$f\" ] || continue; "
            "n=${f##*/}; "
            "printf \"%s\\t%s\\n\" \"$(stat -c %s \"$f\")\" \"$n\"; done")
    out = []
    for line in r.stdout.split("\n"):
        if "\t" not in line:
            continue
        size, _, name = line.partition("\t")
        name = name.strip()
        if not name or not size.strip().isdigit():
            continue
        out.append((int(size.strip()), name))
    return out


def cmd_inbox_sync(c, args):
    import argparse
    p = argparse.ArgumentParser(prog="phonebridge inbox-sync")
    p.add_argument("--dest", default=None)
    ns = p.parse_args(args)
    dev = resolve_device(c)
    if not dev:
        fail("no device")
    dest = os.path.expanduser(ns.dest or cfg_get(c, "phone", "downloads", "~/PhoneBridge"))
    os.makedirs(dest, exist_ok=True)
    inbox = inbox_dir(c)
    pulled, skipped = [], []
    for size, name in inbox_list(dev, inbox):
        if size > INBOX_MAX:
            skipped.append({"name": name, "reason": "too-big", "bytes": size})
            continue
        local = dest + "/" + name
        if os.path.isfile(local) and os.path.getsize(local) == size:
            skipped.append({"name": name, "reason": "already-here"})
            continue
        r = adb(dev, "pull", f"{inbox}/{name}", dest + "/")
        if r.returncode == 0:
            pulled.append({"name": name, "path": local, "bytes": size})
        else:
            skipped.append({"name": name, "reason": "pull-failed"})
    emit({"pulled": pulled, "skipped": skipped})


def cmd_inbox_watch(c, args):
    import argparse
    p = argparse.ArgumentParser(prog="phonebridge inbox-watch")
    p.add_argument("--interval", type=int, default=5)
    p.add_argument("--dest", default=None)
    ns = p.parse_args(args)
    dev = resolve_device(c)
    if not dev:
        fail("no device")
    dest = os.path.expanduser(ns.dest or cfg_get(c, "phone", "downloads", "~/PhoneBridge"))
    os.makedirs(dest, exist_ok=True)
    inbox = inbox_dir(c)
    try:
        while True:
            for size, name in inbox_list(dev, inbox):
                if size > INBOX_MAX:
                    continue
                local = dest + "/" + name
                if os.path.isfile(local) and os.path.getsize(local) == size:
                    continue
                r = adb(dev, "pull", f"{inbox}/{name}", dest + "/")
                if r.returncode == 0:
                    emit({"event": "inbox", "name": name, "path": local, "bytes": size})
                    sys.stdout.flush()
            time.sleep(ns.interval)
    except KeyboardInterrupt:
        pass


# ── notifications ────────────────────────────────────────────────────────
def _string_field(line, name):
    # paren-aware String (...) extraction — titles can contain parens
    # ("Family (149 messages): ~ Jay"); a naive [^)]* would cut them.
    m = re.search(re.escape(name) + r"=String \(", line)
    if not m:
        return None
    i, depth = m.end(), 1
    while i < len(line) and depth:
        if line[i] == "(":
            depth += 1
        elif line[i] == ")":
            depth -= 1
        i += 1
    return line[m.end():i - 1]


def _looks_like_name(t):
    # a sender is a short name (<=3 words, name chars), never a sentence:
    # message previews after a colon ("Jay: hey are you...") must fail.
    t = t.strip().lstrip("~").strip()
    return bool(t) and len(t) <= 32 and bool(
        re.fullmatch(r"[^\W\d_][\w.'’\-]{0,29}(?: [^\W\d_][\w.'’\-]{0,29}){0,2}", t))


def parse_notifs(dump, allow):
    import re
    fresh, cur = [], None

    def flush():
        if cur and cur.get("key"):
            fresh.append(cur)

    for line in dump.split("\n"):
        h = re.search(r"NotificationRecord\([^:]*: pkg=([^\s]+)", line)
        if h:
            if cur is not None:
                flush()
            cur = None
            for sub, label in allow:
                if sub in h.group(1):
                    m = re.search(r"key=([^:\s]+)", line)
                    cur = {"key": m.group(1) if m else None, "title": "",
                           "label": label, "pkg": h.group(1), "sender": "", "body": ""}
                    break
            continue
        if not cur:
            continue
        if not cur["key"]:
            m = re.search(r"key=([^:\s]+)", line)
            if m:
                cur["key"] = m.group(1)
        if not cur["title"]:
            t = _string_field(line, "android.title")
            if t is not None:
                cur["title"] = t
        if not cur.get("body"):
            tb = _string_field(line, "android.text")
            if tb is not None:
                cur["body"] = tb
            else:
                tb = _string_field(line, "android.bigText")
                if tb is not None:
                    cur["body"] = tb
    if cur is not None:
        flush()
    # Extract the author (WHO, not WHAT) for every app, and scrub the title
    # so only a sender name ever reaches the PC — never message content:
    #   WhatsApp: "Group (149 messages): ~ Jay" -> who "Jay"
    #   Telegram: "GroupName: SenderName"        -> who "SenderName"
    #   1:1 hits: "Jay" (title is the contact)   -> who "Jay"
    # Count-only titles ("149 messages") carry no author either way.
    # Anything else might be a message preview -> drop it, keep who only.
    for rec in fresh:
        t = (rec.get("title") or "").strip()
        if not t:
            continue
        sm = re.search(r"[:：]\s*~?\s*([^:：\n]+?)\s*$", t)
        if sm and _looks_like_name(sm.group(1)):
            rec["sender"] = sm.group(1).strip().lstrip("~").strip()
            rec["title"] = ""
            continue
        if re.search(r"\d+\s*(messages?|new|unread)", t.lower()):
            rec["title"] = ""
            continue
        bare = re.sub(r"\s*\([^)]*\)\s*$", "", t)  # "Mom (Mobile)" -> "Mom"
        if _looks_like_name(bare):
            rec["sender"] = bare.strip().lstrip("~").strip()
        rec["title"] = ""
    return fresh


def notif_dump(dev):
    r = adb(dev, "shell", "dumpsys notification --noredact | "
            "sed 's/ Notification(.*//' | "
            "grep -E 'NotificationRecord\\(|key=|android.title|android.text|android.bigText'")
    return r.stdout


def cmd_notifs(c, _args):
    dev = resolve_device(c)
    if not dev:
        fail("no device")
    emit(parse_notifs(notif_dump(dev), notify_apps(c)))


def cmd_notifs_watch(c, args):
    import argparse
    p = argparse.ArgumentParser(prog="phonebridge notifs-watch")
    p.add_argument("--interval", type=int, default=4)
    ns = p.parse_args(args)
    dev = resolve_device(c)
    if not dev:
        fail("no device")
    allow = notify_apps(c)
    seen, primed = [], False
    try:
        while True:
            for rec in parse_notifs(notif_dump(dev), allow):
                if not primed:
                    seen.append(rec["key"])
                    continue
                if rec["key"] in seen:
                    continue
                seen.append(rec["key"])
                if len(seen) > 200:
                    seen.pop(0)
                rec["event"] = "notification"
                emit(rec)
                sys.stdout.flush()
            primed = True
            time.sleep(ns.interval)
    except KeyboardInterrupt:
        pass


def cmd_probe(c, args):
    import argparse
    p = argparse.ArgumentParser(prog="phonebridge probe")
    p.add_argument("--json", action="store_true")
    ns = p.parse_args(args)
    checks = []

    def check(name, ok, note=""):
        checks.append({"name": name, "ok": bool(ok), "note": note})

    if not shutil.which("adb"):
        check("adb", False, "android-tools not installed")
        return finish_probe(checks, ns)
    check("adb", True)
    dev = resolve_device(c)
    if not dev:
        check("device", False, "no device: run init.sh (cable once for tcpip 5555)")
        return finish_probe(checks, ns)
    check("device", True, dev)
    if adb(dev, "shell", "echo ok").stdout.strip() != "ok":
        check("shell", False, "adb shell not answering")
        return finish_probe(checks, ns)
    check("shell", True)
    # relay app installed?
    pm = adb(dev, "shell", "pm", "path", APP_PKG).stdout
    if "package:" not in pm:
        check("relay-app", False, f"{APP_PKG} not installed: run init.sh")
        return finish_probe(checks, ns)
    check("relay-app", True, APP_PKG)
    # all-files access (share-sheet inbox writes need it)
    ops = adb(dev, "shell", "appops", "get", APP_PKG,
              "MANAGE_EXTERNAL_STORAGE").stdout
    check("all-files-access", ": allow" in ops,
          "" if ": allow" in ops else "Settings > Special app access > All files access")
    # inbox writable?
    inbox = inbox_dir(c)
    probe_file = inbox.rstrip("/") + "/.probe"
    w = adb(dev, "shell", f"touch {q(probe_file)} && rm {q(probe_file)} && echo ok")
    check("inbox-writable", w.stdout.strip() == "ok", inbox)
    # share-sheet targets registered? (query with text/plain: this ROM's
    # resolver answers nothing for */* queries even when filters match)
    reg = adb(dev, "shell", "cmd", "package", "query-activities", "--brief",
              "-a", "android.intent.action.SEND", "-t", "text/plain").stdout
    reg_m = adb(dev, "shell", "cmd", "package", "query-activities", "--brief",
                "-a", "android.intent.action.SEND_MULTIPLE", "-t", "text/plain").stdout
    check("share-sheet", APP_PKG in reg and APP_PKG in reg_m,
          "SEND + SEND_MULTIPLE" if APP_PKG in reg and APP_PKG in reg_m else "reinstall the APK")
    # notification dump readable (watcher prerequisite)?
    nd = adb(dev, "shell", "dumpsys notification --noredact | head -c 64").stdout
    nd_ok = len(nd.strip()) > 0
    check("notif-dump", nd_ok, "" if nd_ok else "dumpsys notification blocked?")
    # clipboard push end to end (sets + acks)?
    rdir = f"/sdcard/Android/data/{APP_PKG}/files"
    clip_ok = do_clip_probe(dev, rdir)
    check("clipboard-push", clip_ok, "paste-now only on strict ROMs (see README quirks)")
    return finish_probe(checks, ns)


def do_clip_probe(dev, rdir):
    import tempfile
    with tempfile.NamedTemporaryFile("wb", suffix=".txt", delete=False) as f:
        f.write(b"phonebridge-probe")
        tmp = f.name
    try:
        if adb(dev, "push", tmp, f"{rdir}/in.txt").returncode != 0:
            return False
        if adb(dev, "shell", "am", "start", "-n",
               f"{APP_PKG}/.PhoneBridgeActivity",
               "--es", "mode", "write",
               "--es", "textfile", f"{rdir}/in.txt").returncode != 0:
            return False
        time.sleep(1.5)
        return "OK" in adb(dev, "shell", "cat", f"{rdir}/ack.txt").stdout
    finally:
        os.unlink(tmp)


def finish_probe(checks, ns):
    ok = all(x["ok"] for x in checks)
    if ns.json:
        emit({"ok": ok, "checks": checks})
    else:
        for x in checks:
            mark = "PASS" if x["ok"] else "FAIL"
            line = f"[{mark}] {x['name']}"
            if x["note"]:
                line += f" — {x['note']}"
            print(line)
    sys.exit(0 if ok else 1)


COMMANDS = {
    "devices": cmd_devices,
    "connect": cmd_connect,
    "battery": cmd_battery,
    "clip": cmd_clip,
    "push": cmd_push,
    "pull": cmd_pull,
    "ls": cmd_ls,
    "shot": cmd_shot,
    "ring": cmd_ring,
    "wake": cmd_wake,
    "inbox-sync": cmd_inbox_sync,
    "inbox-watch": cmd_inbox_watch,
    "notifs": cmd_notifs,
    "notifs-watch": cmd_notifs_watch,
    "probe": cmd_probe,
}



def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        print("\ncommands: " + ", ".join(sorted(COMMANDS)))
        sys.exit(0 if len(sys.argv) > 1 else 2)
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        fail(f"unknown command '{cmd}' (try: phonebridge --help)", 2)
    c = load_config()
    COMMANDS[cmd](c, sys.argv[2:])


if __name__ == "__main__":
    main()
